# =============================================================================
# Hanlin Novel Runtime — 环境变量样例
#
# 复制本文件为 backend/.env 并填入真实值：
#   cp backend/.env.example backend/.env
#
# 加载机制（优先级从高到低）：
#   1. 真实 shell 环境变量（export XXX=... 或启动命令注入）
#   2. backend/.env（本文件副本）
#   3. runtime/engine.py 中的代码默认值
#
# 两个加载入口都会读取本文件，任选其一即可生效：
#   - Python 侧：runtime/api.py 在启动时通过 python-dotenv 加载 backend/.env
#     （无论用 `pnpm start` 还是直接 `uvicorn runtime.api:app` 都生效）
#   - Node 侧 ：scripts/start-local-services.js 会解析 backend/.env，并把
#     LLM_* / NOVEL_RUNTIME_* / PROJECT_STORAGE_ROOT 透传给 runtime 进程
#
# ⚠️ 安全：backend/.env 已被 .gitignore 忽略。本文件会进 git，严禁包含真实密钥，
#    真实 key 只能写在 backend/.env 里。
# =============================================================================

# -----------------------------------------------------------------------------
# LLM 接入（统一聚合网关）
#   所有模型统一走 https://model.local.dofe.ai/api/（OpenAI 兼容）；
#   GET /v1/models 可查询支持的模型清单。
#   同一个 base_url + 同一个 key + interface_format=OpenAI，
#   各生成阶段仅靠下面的 LLM_MODEL_* 切换“用哪个模型”。
# -----------------------------------------------------------------------------
LLM_API_KEY=sk-replace-me-in-backend-env
LLM_BASE_URL=https://model.local.dofe.ai/api/
# 网关统一为 OpenAI 兼容协议；原生 Gemini/DeepSeek 客户端格式不再需要。
# TLS：网关证书若由内部 CA 签发，由 runtime/api.py 的 truststore 走 OS 钥匙串信任。
LLM_INTERFACE_FORMAT=OpenAI
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=600

# 默认模型（下方任意角色变量未设置时回退到此）
LLM_MODEL=deepseek-v4-flash

# 按生成阶段指定模型（可选；缺省回退 LLM_MODEL）。
# 角色与 runtime/engine.py 的生成阶段对应：
#   architecture       → 故事架构（Novel_architecture_generate）
#   outline            → 章节大纲（Chapter_blueprint_generate）
#   chapterDraft       → 章节正文草稿
#   consistencyReview  → 事实/一致性抽取
# LLM_MODEL_ARCHITECTURE=gemini-3.5-flash
# LLM_MODEL_OUTLINE=gemini-3.5-flash
# LLM_MODEL_CHAPTER_DRAFT=deepseek-v4-pro
# LLM_MODEL_CONSISTENCY_REVIEW=deepseek-v4-flash

# -----------------------------------------------------------------------------
# Runtime 访问控制与存储
#   本地开发时若不配置，scripts/start-local-services.js 会自动注入开发默认值：
#     NOVEL_RUNTIME_SHARED_SECRET = hanlin_runtime_dev_only
#     PROJECT_STORAGE_ROOT        = <repo>/.local/novel-runtime/projects
#   生产环境务必显式配置强随机 SHARED_SECRET。
# -----------------------------------------------------------------------------
# NOVEL_RUNTIME_SHARED_SECRET=change-me-to-a-strong-random-secret
# PROJECT_STORAGE_ROOT=/data/projects
