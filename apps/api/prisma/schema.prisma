generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// ============================================================================
// User System - 用户系统
// ============================================================================
enum SexType {
  UNKNOWN
  MALE
  FEMALE

  @@map("sex_type")
}

enum FileBucketVendor {
  oss
  us3
  qiniu
  s3
  gcs
  tos
  tencent
  ksyun

  @@map("file_bucket_vendor")
}

enum FileEnvType {
  dev
  test
  prod
  produs
  prodap

  @@map("file_env_type")
}

enum FileAccess {
  public
  private

  @@map("file_access")
}

model UserInfo {
  id           String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ssoSub       String? @unique @map("sso_sub") @db.VarChar(255) /// SSO 用户唯一标识（sso.dofe.ai 的 user.id）
  nickname     String  @default("") @db.VarChar(255)
  code         String? @unique @db.VarChar(255)
  avatarFileId String? @map("avatar_file_id") @db.Uuid /// 头像文件ID，仅保存 sso.dofe.ai 文件ID引用
  sex          SexType @default(UNKNOWN)
  locale       String? @db.VarChar(20)
  isAdmin      Boolean @default(false) @map("is_admin")
  email        String? @db.VarChar(255) /// 本地账号邮箱（EmailAuth 关联，权威来源）
  mobile       String? @db.VarChar(40) /// 本地账号手机号（MobileAuth 关联，权威来源）

  role         String    @default("user")
  isActive     Boolean   @default(true) @map("is_active")
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamptz(6)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ── 本地认证反向关系（自建认证）──
  emailAuth  EmailAuth?
  mobileAuth MobileAuth?
  userMfa    UserMfa?

  @@index([code])
  @@index([ssoSub])
  @@index([isDeleted, isAdmin])
  @@index([createdAt(sort: Desc)])
  @@index([nickname])
  @@index([avatarFileId])
  @@map("u_user_info")
}

// ============================================================================
// Local Auth Tables - 本地账号认证（自建认证，不依赖 sso.dofe.ai）
// ============================================================================
model EmailAuth {
  email                    String   @id @db.VarChar(255)
  password                 String   @db.VarChar(255)
  passwordEncryptionMethod String   @default("Bcrypt") @map("password_encryption_method") @db.VarChar(50)
  verified                 Boolean  @default(false)
  userId                   String   @unique @map("user_id") @db.Uuid
  user                     UserInfo @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("t_email_auth")
}

model MobileAuth {
  mobile                   String   @id @db.VarChar(40)
  password                 String   @db.VarChar(255)
  passwordEncryptionMethod String   @default("Bcrypt") @map("password_encryption_method") @db.VarChar(50)
  verified                 Boolean  @default(false)
  userId                   String   @unique @map("user_id") @db.Uuid
  user                     UserInfo @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("t_mobile_auth")
}

/// 预留：多因素认证（本期不接 API，仅建表以备后续 TOTP）
model UserMfa {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  mfaType     String   @default("TOTP") @map("mfa_type") @db.VarChar(20)
  secret      String   @db.Text
  enabled     Boolean  @default(false)
  backupCodes String[] @map("backup_codes")
  user        UserInfo @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("t_user_mfa")
}

// ============================================================================
// File Source - 文件元数据（本地对象存储，TOS 预签名直传）
// ============================================================================
model FileSource {
  id       String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key      String           @unique @db.VarChar(255)
  bucket   String           @db.VarChar(255)
  vendor   FileBucketVendor @default(tos)
  region   String           @default("cn-beijing") @db.VarChar(50)
  filename String?          @db.VarChar(255)
  fsize    Float
  mimeType String           @map("mime_type") @db.VarChar(255)
  ext      String           @db.VarChar(20)
  sha256   String?          @db.VarChar(64)
  hash     String?          @db.VarChar(255)
  thumbImg String?          @map("thumb_img") @db.Text
  parts    Int[]

  isUploaded Boolean     @default(false) @map("is_uploaded")
  status     Int         @default(0)
  env        FileEnvType @default(prod)

  scope      String     @default("general") @db.VarChar(50)
  access     FileAccess @default(public)
  uploadedBy String?    @map("uploaded_by") @db.Uuid
  tenantId   String?    @map("tenant_id") @db.Uuid
  teamId     String?    @map("team_id") @db.Uuid
  metadata   Json?

  expireAt              DateTime? @map("expire_at") @db.Timestamptz(6)
  transitionToIaAt      DateTime? @map("transition_to_ia_at") @db.Timestamptz(6)
  transitionToArchiveAt DateTime? @map("transition_to_archive_at") @db.Timestamptz(6)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([uploadedBy, isUploaded, isDeleted])
  @@index([scope, isUploaded, isDeleted])
  @@index([tenantId, isUploaded, isDeleted])
  @@index([bucket])
  @@map("f_file_source")
}

// ============================================================================
// Country Code - 国家代码（用于 IP 信息）
// ============================================================================

model CountryCode {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  continent String    @db.VarChar(10) // us, eu, ap, cn
  code      String    @db.VarChar(10) // 国家代码，如 CN, US, SG
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([continent, code])
  @@index([continent])
  @@index([code])
  @@map("country_code")
}

/// 审计日志（参考 models.dofe.ai：业务主动调用 AuditLogService 记录管理操作，不挂全局拦截器）
model AuditLog {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // 操作信息
  action     AuditActionType @map("action")
  resource   String          @map("resource") @db.VarChar(100)
  resourceId String?         @map("resource_id") @db.VarChar(255)

  // 操作者
  actorType String  @map("actor_type") @db.VarChar(50)
  actorId   String? @map("actor_id") @db.VarChar(255)
  teamId    String? @map("team_id") @db.Uuid

  // 操作详情
  changes  Json? @map("changes")
  metadata Json? @map("metadata")

  // 结果
  status   String  @default("success") @map("status") @db.VarChar(20)
  errorMsg String? @map("error_msg") @db.VarChar(500)

  // 请求信息
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, actorId])
  @@index([action, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@index([actorId])
  @@map("audit_logs")
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACCESS
  EXPORT
  IMPORT

  @@map("audit_action_type")
}

// NestJS owns project ownership and generation history. Python receives only
// the scoped execution request and is never the source of truth for either.
enum StudioGenerationRunStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("studio_generation_run_status")
}

enum StudioGenerationRunType {
  BLUEPRINT     @map("blueprint")
  CHAPTER_DRAFT @map("chapter_draft")

  @@map("studio_generation_run_type")
}

enum StudioProjectEventType {
  GENERATION_STATUS        @map("generation_status")
  FINALIZATION_TASK_STATUS @map("finalization_task_status")
  FACT_CHANGE_DECISION     @map("fact_change_decision")

  @@map("studio_project_event_type")
}

enum StudioBlueprintStatus {
  DRAFT     @map("draft")
  CONFIRMED @map("confirmed")

  @@map("studio_blueprint_status")
}

enum StudioChapterPlanStatus {
  DRAFT     @map("draft")
  CONFIRMED @map("confirmed")

  @@map("studio_chapter_plan_status")
}

enum StudioChapterRevisionStatus {
  DRAFT      @map("draft")
  FINALIZED  @map("finalized")
  SUPERSEDED @map("superseded")

  @@map("studio_chapter_revision_status")
}

enum StudioChapterFinalizationStatus {
  PENDING     @map("pending")
  FINALIZING  @map("finalizing")
  FINALIZED   @map("finalized")
  FAILED      @map("failed")
  RECOVERABLE @map("recoverable")

  @@map("studio_chapter_finalization_status")
}

enum StudioProjectImportStatus {
  PREVIEWED @map("previewed")
  IMPORTED  @map("imported")
}

// An adaptation is a separate creative work. It never mutates the source
// novel, and every adaptation starts from one immutable source snapshot.
enum StudioAdaptationTargetFormat {
  SERIES      @map("series")
  SHORT_DRAMA @map("short_drama")

  @@map("studio_adaptation_target_format")
}

enum StudioAdaptationStatus {
  BRIEF_DRAFT      @map("brief_draft")
  BLUEPRINT_REVIEW @map("blueprint_review")
  SCENE_PLANNING   @map("scene_planning")
  SCRIPT_WRITING   @map("script_writing")
  REVIEW_READY     @map("review_ready")
  DELIVERABLE      @map("deliverable")

  @@map("studio_adaptation_status")
}

// Adaptation decisions are explicit author-reviewed changes from the source
// novel. A decision always retains its source chapter anchor for later review.
enum StudioAdaptationDecisionType {
  CUT        @map("cut")
  MERGE      @map("merge")
  REORDER    @map("reorder")
  POV_CHANGE @map("pov_change")
  EXPAND     @map("expand")

  @@map("studio_adaptation_decision_type")
}

enum StudioAdaptationDecisionImpact {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")

  @@map("studio_adaptation_decision_impact")
}

enum StudioAdaptationDecisionStatus {
  PROPOSED @map("proposed")
  ACCEPTED @map("accepted")
  EDITED   @map("edited")
  REJECTED @map("rejected")

  @@map("studio_adaptation_decision_status")
}

// Source-scene mappings trace a planned scene back to the immutable source
// chapter(s) it adapts. `stale` is set when the source snapshot or an upstream
// decision changes, so the author must re-confirm the link (PRD P13 traceability).
enum StudioSourceMappingStatus {
  PROPOSED  @map("proposed")
  CONFIRMED @map("confirmed")
  STALE     @map("stale")

  @@map("studio_source_mapping_status")
}

enum StudioFinalizationTaskStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  FAILED    @map("failed")

  @@map("studio_finalization_task_status")
}

enum StudioFinalizationOutboxTaskType {
  SUMMARY @map("summary")
  INDEX   @map("index")

  @@map("studio_finalization_outbox_task_type")
}

enum StudioFinalizationOutboxTaskStatus {
  PENDING     @map("pending")
  RUNNING     @map("running")
  COMPLETED   @map("completed")
  FAILED      @map("failed")
  RECOVERABLE @map("recoverable")

  @@map("studio_finalization_outbox_task_status")
}

enum StudioReviewFindingSeverity {
  BLOCKING @map("blocking")
  WARNING  @map("warning")
  INFO     @map("info")

  @@map("studio_review_finding_severity")
}

enum StudioReviewFindingStatus {
  OPEN               @map("open")
  RESOLVED           @map("resolved")
  IGNORED            @map("ignored")
  INTENTIONAL_CHANGE @map("intentional_change")

  @@map("studio_review_finding_status")
}

enum StudioFactStatus {
  CONFIRMED @map("confirmed")
  RETIRED   @map("retired")

  @@map("studio_fact_status")
}

enum StudioFactChangeOperation {
  ADD    @map("add")
  UPDATE @map("update")
  REMOVE @map("remove")

  @@map("studio_fact_change_operation")
}

enum StudioFactChangeStatus {
  PROPOSED                      @map("proposed")
  ACCEPTED_PENDING_FINALIZATION @map("accepted_pending_finalization")
  ACCEPTED                      @map("accepted")
  REJECTED                      @map("rejected")

  @@map("studio_fact_change_status")
}

model StudioProject {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId               String   @map("owner_id") @db.Uuid
  title                 String   @db.VarChar(120)
  format                String   @default("novel") @db.VarChar(20)
  genre                 String   @db.VarChar(80)
  premise               String   @db.Text
  chapterCount          Int      @map("chapter_count")
  targetWordsPerChapter Int      @map("target_words_per_chapter")
  guidance              String   @default("") @db.Text
  generateOutline       Boolean  @default(true) @map("generate_outline")
  currentBlueprintId    String?  @unique @map("current_blueprint_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  runs                      StudioGenerationRun[]
  blueprints                StudioBlueprint[]                @relation("StudioProjectBlueprints")
  currentBlueprint          StudioBlueprint?                 @relation("StudioProjectCurrentBlueprint", fields: [currentBlueprintId], references: [id], onDelete: SetNull)
  chapterPlans              StudioChapterPlan[]
  chapterRevisions          StudioChapterRevision[]
  chapterDraftPointers      StudioChapterDraftPointer[]
  chapterFinalizations      StudioChapterFinalization[]
  finalizationFactSnapshots StudioFinalizationFactSnapshot[]
  finalizationTasks         StudioFinalizationOutboxTask[]
  chapterFinalPointers      StudioChapterFinalPointer[]
  facts                     StudioFact[]
  factChanges               StudioFactChange[]
  reviewFindings            StudioReviewFinding[]
  imports                   StudioProjectImport[]
  events                    StudioProjectEvent[]
  adaptations               StudioAdaptationProject[]        @relation("StudioAdaptationSourceProject")
  adaptationSnapshots       StudioAdaptationSourceSnapshot[] @relation("StudioAdaptationSnapshotSourceProject")

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("studio_projects")
}

model StudioProjectEvent {
  id        String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId String                 @map("project_id") @db.Uuid
  type      StudioProjectEventType
  payload   Json                   @default("{}")
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("studio_project_events")
}

// Raw bytes are retained as Base64 until the author confirms the import.
// Parsed chapter metadata is a preview only; it is never the source of truth.
model StudioProjectImport {
  id                  String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId             String                    @map("owner_id") @db.Uuid
  projectId           String?                   @unique @map("project_id") @db.Uuid
  filename            String                    @db.VarChar(255)
  sourceFormat        String                    @map("source_format") @db.VarChar(20)
  sourceContentBase64 String                    @map("source_content_base64") @db.Text
  contentHash         String                    @map("content_hash") @db.Char(64)
  preview             Json                      @default("{}")
  status              StudioProjectImportStatus @default(PREVIEWED)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt         DateTime?                 @map("confirmed_at") @db.Timestamptz(6)

  project StudioProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("studio_project_imports")
}

model StudioAdaptationProject {
  id                String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId           String                       @map("owner_id") @db.Uuid
  sourceProjectId   String                       @map("source_project_id") @db.Uuid
  targetFormat      StudioAdaptationTargetFormat @map("target_format")
  episodeCount      Int                          @map("episode_count")
  minutesPerEpisode Int                          @map("minutes_per_episode")
  targetAudience    String                       @default("") @map("target_audience") @db.VarChar(500)
  adaptationGoal    String                       @default("") @map("adaptation_goal") @db.Text
  mustPreserve      String                       @default("") @map("must_preserve") @db.Text
  rightsConfirmedAt DateTime                     @map("rights_confirmed_at") @db.Timestamptz(6)
  status            StudioAdaptationStatus       @default(BRIEF_DRAFT)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceProject  StudioProject                   @relation("StudioAdaptationSourceProject", fields: [sourceProjectId], references: [id], onDelete: Restrict)
  sourceSnapshot StudioAdaptationSourceSnapshot?
  decisions      StudioAdaptationDecision[]
  scenePlans     StudioScenePlan[]
  sourceMappings StudioSourceSceneMapping[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([sourceProjectId, createdAt(sort: Desc)])
  @@map("studio_adaptation_projects")
}

// Source text is copied when an author starts an adaptation. Later edits to
// the novel cannot silently change the material used for screenplay work.
model StudioAdaptationSourceSnapshot {
  id                     String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adaptationId           String   @unique @map("adaptation_id") @db.Uuid
  sourceProjectId        String   @map("source_project_id") @db.Uuid
  sourceProjectTitle     String   @map("source_project_title") @db.VarChar(120)
  sourceProjectUpdatedAt DateTime @map("source_project_updated_at") @db.Timestamptz(6)
  sourceChapterCount     Int      @map("source_chapter_count")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adaptation    StudioAdaptationProject         @relation(fields: [adaptationId], references: [id], onDelete: Restrict)
  sourceProject StudioProject                   @relation("StudioAdaptationSnapshotSourceProject", fields: [sourceProjectId], references: [id], onDelete: Restrict)
  chapters      StudioAdaptationSourceChapter[]
  decisions     StudioAdaptationDecision[]

  @@index([sourceProjectId, createdAt(sort: Desc)])
  @@map("studio_adaptation_source_snapshots")
}

model StudioAdaptationSourceChapter {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  snapshotId       String   @map("snapshot_id") @db.Uuid
  sourceRevisionId String   @map("source_revision_id") @db.Uuid
  chapterNumber    Int      @map("chapter_number")
  title            String   @db.VarChar(200)
  content          String   @db.Text
  contentHash      String   @map("content_hash") @db.Char(64)
  wordCount        Int      @map("word_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  snapshot       StudioAdaptationSourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceRevision StudioChapterRevision          @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  decisions      StudioAdaptationDecision[]
  sourceMappings StudioSourceSceneMapping[]

  @@unique([snapshotId, chapterNumber])
  @@index([sourceRevisionId])
  @@map("studio_adaptation_source_chapters")
}

model StudioAdaptationDecision {
  id               String                         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adaptationId     String                         @map("adaptation_id") @db.Uuid
  snapshotId       String                         @map("snapshot_id") @db.Uuid
  sourceChapterId  String                         @map("source_chapter_id") @db.Uuid
  type             StudioAdaptationDecisionType
  impact           StudioAdaptationDecisionImpact
  proposal         String                         @db.Text
  rationale        String                         @db.Text
  status           StudioAdaptationDecisionStatus @default(PROPOSED)
  resolutionReason String?                        @map("resolution_reason") @db.Text
  resolvedAt       DateTime?                      @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)

  adaptation    StudioAdaptationProject        @relation(fields: [adaptationId], references: [id], onDelete: Restrict)
  snapshot      StudioAdaptationSourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceChapter StudioAdaptationSourceChapter  @relation(fields: [sourceChapterId], references: [id], onDelete: Restrict)

  @@index([adaptationId, status, createdAt(sort: Desc)])
  @@index([sourceChapterId])
  @@map("studio_adaptation_decisions")
}

// Per-episode scene plan authored during the scene_planning stage. Each scene
// may anchor to one or more immutable source chapters so downstream screenplay
// generation and source-scene mapping stay traceable. `needsReview` is set when
// upstream decisions or the source snapshot change, blocking scene confirmation.
model StudioScenePlan {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adaptationId  String   @map("adaptation_id") @db.Uuid
  episodeNumber Int      @map("episode_number") @db.SmallInt
  title         String   @db.VarChar(200)
  synopsis      String   @db.Text
  sceneOutline  Json
  needsReview   Boolean  @default(false) @map("needs_review")
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  adaptation StudioAdaptationProject @relation(fields: [adaptationId], references: [id], onDelete: Restrict)
  sourceMappings StudioSourceSceneMapping[]

  @@unique([adaptationId, episodeNumber])
  @@index([adaptationId, episodeNumber])
  @@map("studio_scene_plans")
}

// Normalized, reviewable traceability link between a planned scene and the
// immutable source chapter it adapts. Complements the `sourceChapterIds` hint
// stored inside `StudioScenePlan.sceneOutline` with a queryable, status-bearing
// record that survives outline edits and can be marked stale for re-review.
model StudioSourceSceneMapping {
  id              String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adaptationId    String                    @map("adaptation_id") @db.Uuid
  scenePlanId     String                    @map("scene_plan_id") @db.Uuid
  episodeNumber   Int                       @map("episode_number") @db.SmallInt
  sceneNumber     Int                       @map("scene_number") @db.SmallInt
  sourceChapterId String                    @map("source_chapter_id") @db.Uuid
  evidenceAnchor  String?                   @map("evidence_anchor") @db.Text
  status          StudioSourceMappingStatus @default(PROPOSED)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  adaptation    StudioAdaptationProject       @relation(fields: [adaptationId], references: [id], onDelete: Restrict)
  scenePlan     StudioScenePlan               @relation(fields: [scenePlanId], references: [id], onDelete: Restrict)
  sourceChapter StudioAdaptationSourceChapter @relation(fields: [sourceChapterId], references: [id], onDelete: Restrict)

  @@unique([scenePlanId, sceneNumber, sourceChapterId])
  @@index([adaptationId, status, createdAt(sort: Desc)])
  @@map("studio_source_scene_mappings")
}

model StudioGenerationRun {
  id             String                    @id @db.Uuid
  projectId      String                    @map("project_id") @db.Uuid
  chapterPlanId  String?                   @map("chapter_plan_id") @db.Uuid
  type           StudioGenerationRunType   @default(BLUEPRINT)
  status         StudioGenerationRunStatus @default(QUEUED)
  progress       Int                       @default(0)
  currentStep    String                    @default("Queued for generation") @map("current_step") @db.VarChar(255)
  architecture   String?                   @db.Text
  outline        String?                   @db.Text
  chapterContent String?                   @map("chapter_content") @db.Text
  inputSummary   String?                   @map("input_summary") @db.Text
  modelConfig    Json                      @default("{}") @map("model_config")
  factChanges    Json                      @default("[]") @map("fact_changes")
  attemptCount   Int                       @default(0) @map("attempt_count")
  error          String?                   @db.Text
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  project          StudioProject           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  chapterPlan      StudioChapterPlan?      @relation(fields: [chapterPlanId], references: [id], onDelete: Restrict)
  blueprints       StudioBlueprint[]
  chapterRevisions StudioChapterRevision[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([chapterPlanId, createdAt(sort: Desc)])
  @@map("studio_generation_runs")
}

model StudioBlueprint {
  id            String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId     String                @map("project_id") @db.Uuid
  runId         String?               @unique @map("run_id") @db.Uuid
  version       Int
  status        StudioBlueprintStatus @default(DRAFT)
  architecture  String                @db.Text
  outline       String                @default("") @db.Text
  source        String                @default("ai") @db.VarChar(20)
  schemaVersion Int                   @default(1) @map("schema_version")
  contentHash   String                @map("content_hash") @db.Char(64)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  project           StudioProject        @relation("StudioProjectBlueprints", fields: [projectId], references: [id], onDelete: Restrict)
  sourceRun         StudioGenerationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  currentForProject StudioProject?       @relation("StudioProjectCurrentBlueprint")
  chapterPlans      StudioChapterPlan[]

  @@unique([projectId, version])
  @@index([projectId, status, version(sort: Desc)])
  @@map("studio_blueprints")
}

model StudioChapterPlan {
  id             String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId      String                  @map("project_id") @db.Uuid
  blueprintId    String                  @map("blueprint_id") @db.Uuid
  chapterNumber  Int                     @map("chapter_number")
  version        Int
  status         StudioChapterPlanStatus @default(DRAFT)
  needsReview    Boolean                 @default(false) @map("needs_review")
  title          String                  @db.VarChar(200)
  goal           String                  @db.Text
  conflict       String                  @default("") @db.Text
  characters     Json                    @default("[]")
  location       String                  @default("") @db.VarChar(200)
  timeConstraint String                  @default("") @map("time_constraint") @db.VarChar(500)
  foreshadowing  String                  @default("") @db.Text
  hook           String                  @default("") @db.Text
  source         String                  @default("author") @db.VarChar(20)
  schemaVersion  Int                     @default(1) @map("schema_version")
  contentHash    String                  @map("content_hash") @db.Char(64)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  project   StudioProject           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  blueprint StudioBlueprint         @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  runs      StudioGenerationRun[]
  revisions StudioChapterRevision[]

  @@unique([projectId, chapterNumber, version])
  @@index([projectId, chapterNumber, version(sort: Desc)])
  @@index([projectId, status, chapterNumber])
  @@map("studio_chapter_plans")
}

model StudioChapterRevision {
  // AI revisions retain their runtime linkage; author revisions use the
  // sourceRevision relation so authorship never masquerades as a generation run.
  id               String                      @id @db.Uuid
  projectId        String                      @map("project_id") @db.Uuid
  chapterPlanId    String                      @map("chapter_plan_id") @db.Uuid
  runId            String?                     @unique @map("run_id") @db.Uuid
  chapterNumber    Int                         @map("chapter_number")
  version          Int
  status           StudioChapterRevisionStatus @default(DRAFT)
  content          String                      @db.Text
  wordCount        Int                         @map("word_count")
  promptSummary    String                      @default("") @map("prompt_summary") @db.Text
  modelConfig      Json                        @default("{}") @map("model_config")
  source           String                      @default("ai") @db.VarChar(20)
  schemaVersion    Int                         @default(1) @map("schema_version")
  contentHash      String                      @map("content_hash") @db.Char(64)
  sourceRevisionId String?                     @map("source_revision_id") @db.Uuid
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  project                  StudioProject                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  chapterPlan              StudioChapterPlan               @relation(fields: [chapterPlanId], references: [id], onDelete: Restrict)
  sourceRun                StudioGenerationRun?            @relation(fields: [runId], references: [id], onDelete: Restrict)
  sourceRevision           StudioChapterRevision?          @relation("StudioRevisionLineage", fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  derivedRevisions         StudioChapterRevision[]         @relation("StudioRevisionLineage")
  currentPointer           StudioChapterDraftPointer?
  finalization             StudioChapterFinalization?
  currentFinal             StudioChapterFinalPointer?
  factChanges              StudioFactChange[]
  reviewFindings           StudioReviewFinding[]
  adaptationSourceChapters StudioAdaptationSourceChapter[]

  @@unique([projectId, chapterNumber, version])
  @@index([projectId, chapterNumber, createdAt(sort: Desc)])
  @@map("studio_chapter_revisions")
}

model StudioFact {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  sourceChangeId   String?          @unique @map("source_change_id") @db.Uuid
  factType         String           @map("fact_type") @db.VarChar(80)
  subject          String           @db.VarChar(200)
  predicate        String           @db.VarChar(200)
  value            String           @db.Text
  effectiveChapter Int              @map("effective_chapter")
  status           StudioFactStatus @default(CONFIRMED)
  schemaVersion    Int              @default(1) @map("schema_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  project        StudioProject         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceChange   StudioFactChange?     @relation("FactCreatedFromChange", fields: [sourceChangeId], references: [id], onDelete: SetNull)
  targetChanges  StudioFactChange[]    @relation("FactTargetChanges")
  reviewFindings StudioReviewFinding[]

  @@index([projectId, status, effectiveChapter])
  @@index([projectId, factType, subject])
  @@map("studio_facts")
}

model StudioReviewFinding {
  id               String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  findingKey       String                      @unique @map("finding_key") @db.Char(64)
  projectId        String                      @map("project_id") @db.Uuid
  revisionId       String                      @map("revision_id") @db.Uuid
  chapterNumber    Int                         @map("chapter_number")
  factId           String?                     @map("fact_id") @db.Uuid
  ruleId           String                      @map("rule_id") @db.VarChar(120)
  severity         StudioReviewFindingSeverity
  status           StudioReviewFindingStatus   @default(OPEN)
  evidenceStart    Int                         @map("evidence_start")
  evidenceEnd      Int                         @map("evidence_end")
  evidence         String                      @db.Text
  suggestedAction  String                      @map("suggested_action") @db.Text
  resolutionReason String?                     @map("resolution_reason") @db.Text
  resolvedAt       DateTime?                   @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  project  StudioProject         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revision StudioChapterRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  fact     StudioFact?           @relation(fields: [factId], references: [id], onDelete: SetNull)

  @@index([projectId, chapterNumber, severity, status])
  @@index([revisionId, status])
  @@map("studio_review_findings")
}

model StudioFactChange {
  id            String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId     String                    @map("project_id") @db.Uuid
  revisionId    String                    @map("revision_id") @db.Uuid
  chapterNumber Int                       @map("chapter_number")
  factId        String?                   @map("fact_id") @db.Uuid
  operation     StudioFactChangeOperation
  factType      String                    @map("fact_type") @db.VarChar(80)
  subject       String                    @db.VarChar(200)
  predicate     String                    @db.VarChar(200)
  proposedValue String                    @default("") @map("proposed_value") @db.Text
  rationale     String                    @default("") @db.Text
  evidence      String                    @default("") @db.Text
  confidence    Float?
  source        String                    @default("ai") @db.VarChar(20)
  status        StudioFactChangeStatus    @default(PROPOSED)
  resolvedValue String?                   @map("resolved_value") @db.Text
  resolvedAt    DateTime?                 @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  project     StudioProject         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revision    StudioChapterRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  targetFact  StudioFact?           @relation("FactTargetChanges", fields: [factId], references: [id], onDelete: Restrict)
  createdFact StudioFact?           @relation("FactCreatedFromChange")

  @@index([projectId, chapterNumber, status])
  @@index([revisionId, status])
  @@map("studio_fact_changes")
}

// A restore only changes this pointer. It never updates or deletes the
// immutable revision selected by the author.
model StudioChapterDraftPointer {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  chapterNumber Int      @map("chapter_number")
  revisionId    String   @unique @map("revision_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project  StudioProject         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revision StudioChapterRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([projectId, chapterNumber])
  @@map("studio_chapter_draft_pointers")
}

// Finalization never mutates a revision's content. This pointer selects the
// final revision used by later export and generation-context work.
model StudioChapterFinalPointer {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  chapterNumber Int      @map("chapter_number")
  revisionId    String   @unique @map("revision_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project  StudioProject         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revision StudioChapterRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([projectId, chapterNumber])
  @@map("studio_chapter_final_pointers")
}

// The transaction record is the durable source for post-finalization tasks.
// Summary and index work remain visibly pending until their executors exist.
model StudioChapterFinalization {
  id                   String                          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId            String                          @map("project_id") @db.Uuid
  revisionId           String                          @unique @map("revision_id") @db.Uuid
  chapterNumber        Int                             @map("chapter_number")
  status               StudioChapterFinalizationStatus @default(FINALIZED)
  factSnapshotRecorded Boolean                         @default(false) @map("fact_snapshot_recorded")
  summaryStatus        StudioFinalizationTaskStatus    @default(PENDING) @map("summary_status")
  indexStatus          StudioFinalizationTaskStatus    @default(PENDING) @map("index_status")
  summary              String?                         @db.Text
  error                String?                         @db.Text
  finalizedAt          DateTime                        @default(now()) @map("finalized_at") @db.Timestamptz(6)
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  project       StudioProject                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revision      StudioChapterRevision            @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  tasks         StudioFinalizationOutboxTask[]
  factSnapshots StudioFinalizationFactSnapshot[]

  @@index([projectId, chapterNumber, finalizedAt(sort: Desc)])
  @@map("studio_chapter_finalizations")
}

// A finalization snapshot captures the confirmed fact state used by all later
// generation. Restoring a historical finalization reconstructs current facts
// from this immutable record instead of mixing facts from two timelines.
model StudioFinalizationFactSnapshot {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  finalizationId   String           @map("finalization_id") @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  sourceFactId     String           @map("source_fact_id") @db.Uuid
  factType         String           @map("fact_type") @db.VarChar(80)
  subject          String           @db.VarChar(200)
  predicate        String           @db.VarChar(200)
  value            String           @db.Text
  effectiveChapter Int              @map("effective_chapter")
  status           StudioFactStatus
  schemaVersion    Int              @default(1) @map("schema_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  finalization StudioChapterFinalization @relation(fields: [finalizationId], references: [id], onDelete: Restrict)
  project      StudioProject             @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([finalizationId, sourceFactId])
  @@index([projectId, finalizationId])
  @@map("studio_finalization_fact_snapshots")
}

// The outbox is committed with the finalization and can be retried independently.
model StudioFinalizationOutboxTask {
  id             String                             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  finalizationId String                             @map("finalization_id") @db.Uuid
  projectId      String                             @map("project_id") @db.Uuid
  revisionId     String                             @map("revision_id") @db.Uuid
  chapterNumber  Int                                @map("chapter_number")
  type           StudioFinalizationOutboxTaskType
  status         StudioFinalizationOutboxTaskStatus @default(PENDING)
  idempotencyKey String                             @unique @map("idempotency_key") @db.VarChar(160)
  attemptCount   Int                                @default(0) @map("attempt_count")
  lastError      String?                            @map("last_error") @db.Text
  payload        Json                               @default("{}")
  result         Json?
  completedAt    DateTime?                          @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(6)

  finalization StudioChapterFinalization @relation(fields: [finalizationId], references: [id], onDelete: Restrict)
  project      StudioProject             @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([finalizationId, type])
  @@index([status, createdAt])
  @@index([projectId, chapterNumber])
  @@map("studio_finalization_outbox_tasks")
}
